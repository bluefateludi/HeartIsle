---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Illustration from '../components/Illustration.astro';
import { formatDate, withBase } from '../lib/site';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = articles[0];
---
<Layout>
  <main id="main" class="shell home">
    <section class="intro" aria-labelledby="welcome">
      <p class="eyebrow" lang="en">A QUIET PLACE TO FEEL</p>
      <h1 id="welcome">给情绪一个<br class="mobile-break" />停靠的地方<span class="period">。</span></h1>
      <p class="intro-copy">读一些关于情绪、自己与生活的文字。<br />让每一种感受，都有被理解的可能。</p>
    </section>
    <Illustration />
    <section id="featured" class="featured" aria-labelledby="featured-title">
      <div class="section-heading">
        <h2 id="featured-title">今日精选</h2>
        <span lang="en">A MOMENT FOR YOURSELF</span>
      </div>
      {featured ? (
        <a class="article-card" href={withBase(`articles/${featured.id}/`)}>
          <div class="card-main">
            <div class="article-meta">
              <span>{featured.data.placeholder ? '内容待提供' : '精选阅读'}</span>
              {!featured.data.placeholder && <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>}
            </div>
            <h3>{featured.data.title}</h3>
            <p>{featured.data.summary}</p>
            <div class="tags">{featured.data.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
          <span class="card-action">{featured.data.placeholder ? '查看内容位置' : '开始阅读'} <span aria-hidden="true">↗</span></span>
        </a>
      ) : (
        <p class="empty-state">第一篇文章正在准备中。</p>
      )}
    </section>
  </main>
</Layout>
